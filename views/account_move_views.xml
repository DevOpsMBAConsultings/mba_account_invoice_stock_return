<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_stock_return" model="ir.ui.view">
        <field name="name">account.move.form.inherit.stock.return</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        type="object"
                        name="action_open_stock_return_wizard"
                        icon="fa-truck"
                        invisible="move_type != 'out_refund' or stock_return_picking_id">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Regresar a</span>
                        <span class="o_stat_text">Bodega</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_open_stock_return_wizard"
                        string="Devolver a Bodega"
                        type="object"
                        class="btn-secondary"
                        invisible="move_type != 'out_refund' or state != 'posted' or stock_return_picking_id"/>
            </xpath>
            <xpath expr="//field[@name='reversed_entry_id']" position="after">
                <field name="stock_return_picking_id"
                       options="{'no_create': True}"
                       invisible="move_type != 'out_refund' or not stock_return_picking_id"
                       readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
